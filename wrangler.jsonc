{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "voidpay",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "voidpay"
    }
  ],
  "routes": [{ "pattern": "voidpay.xyz", "custom_domain": true }],
  // TODO(cutover): set false after custom_domain is live
  "workers_dev": true,
  "preview_urls": false,
  // Enables trusting cf-connecting-ip in clientIp(); must NOT be set on Vercel.
  // OG_FONTS_BASE_URL: /api/og fetches fonts from this origin on Workers (no VERCEL_URL).
  "vars": { "DEPLOY_PLATFORM": "cloudflare", "OG_FONTS_BASE_URL": "https://voidpay.xyz" },
  "previews": {},
  "observability": { "enabled": false }
  // Secrets are NOT stored here — use `wrangler secret put` (see docs/deploy-cloudflare.md).
}
