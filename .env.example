# RPC Provider API Keys (server-side only, routed via /api/rpc proxy)
# ALCHEMY_API_KEY=your-alchemy-api-key
# INFURA_API_KEY=your-infura-api-key

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# Testnet Mode (set to 'true' to enable testnet networks)
NEXT_PUBLIC_ENABLE_TESTNETS=false

# Application URL (for invoice URL generation)
NEXT_PUBLIC_APP_URL=https://voidpay.xyz

# Coming Soon Mode (set to 'true' for production during pre-launch)
NEXT_PUBLIC_COMING_SOON_MODE=false

# Formspree form ID for waitlist (get from https://formspree.io)
NEXT_PUBLIC_FORMSPREE_ID=your-form-id
