{
  "name": "voidpay",
  "version": "1.1.0",
  "description": "VoidPay - Privacy-first stateless crypto invoicing platform with URL-based state",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "type-check:build": "tsc --build tsconfig.build.json",
    "type-check:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "validate": "pnpm type-check && pnpm lint && pnpm test run",
    "check:block-drift": "pnpm dlx tsx scripts/measure-block-times.ts",
    "prepare": "husky",
    "video:studio": "remotion studio",
    "video:render:full": "remotion render VoidPayDemo-16x9 public/video/voidpay-full.mp4",
    "video:render:twitter": "remotion render VoidPayDemo-16x9 public/video/voidpay-twitter.mp4 --frames=0-360",
    "video:render:landing": "remotion render VoidPayDemo-16x9 public/video/voidpay-landing.mp4 --frames=0-1200",
    "video:render:1x1": "remotion render VoidPayDemo-1x1 public/video/voidpay-1x1.mp4",
    "video:render:9x16": "remotion render VoidPayDemo-9x16 public/video/voidpay-9x16.mp4",
    "video:poster": "remotion still Thumbnail-Scene5 public/video/poster-scene5.png --frame=260",
    "video:render:all": "pnpm video:render:full && pnpm video:render:twitter && pnpm video:render:landing && pnpm video:render:1x1 && pnpm video:render:9x16 && pnpm video:poster"
  },
  "keywords": [
    "crypto",
    "invoice",
    "web3",
    "stateless",
    "privacy",
    "nextjs",
    "turbopack"
  ],
  "author": "VoidPay Team",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/fonts": "^4.0.0",
    "@remotion/tailwind-v4": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "remotion": "^4.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/pdfmake": "^0.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-istanbul": "^4.1.2",
    "eslint": "9.17.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lucide-static": "^1.8.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tanstack/react-query": "^5.99.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@web3icons/react": "^4.1.17",
    "blo": "^2.0.0",
    "brotli-wasm": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "next": "^15.5.14",
    "next-sitemap": "^4.2.3",
    "pdfmake": "^0.3.7",
    "pixi.js": "^8.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "react-hook-form": "^7.72.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "use-debounce": "^10.1.1",
    "uuid": "^13.0.0",
    "viem": "^2.47.16",
    "wagmi": "^2.19.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
