{
  "name": "voidpay",
  "version": "1.0.0",
  "description": "VoidPay - Privacy-first stateless crypto invoicing platform with URL-based state",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "type-check:build": "tsc --build tsconfig.build.json",
    "type-check:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "validate": "pnpm type-check && pnpm lint && pnpm test run",
    "prepare": "husky"
  },
  "keywords": [
    "crypto",
    "invoice",
    "web3",
    "stateless",
    "privacy",
    "nextjs",
    "turbopack"
  ],
  "author": "VoidPay Team",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.2.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/pdfmake": "^0.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-istanbul": "^4.0.16",
    "eslint": "9.17.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lucide-static": "^1.7.0",
    "postcss": "^8.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.2.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tanstack/react-query": "^5.90.12",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.37.0",
    "@web3icons/react": "^4.1.14",
    "blo": "^2.0.0",
    "brotli-wasm": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "framer-motion": "^12.23.26",
    "geist": "^1.5.1",
    "next": "^15.5.9",
    "next-sitemap": "^4.2.3",
    "pdfmake": "^0.3.7",
    "pixi.js": "^8.14.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "react-hook-form": "^7.70.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "viem": "^2.47.6",
    "wagmi": "^2.19.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
